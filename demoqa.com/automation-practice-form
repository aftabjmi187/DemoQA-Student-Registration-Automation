
package AutomationTesting;

import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.Keys;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.Select;
import org.openqa.selenium.support.ui.WebDriverWait;

public class TC_WaitStmt {

	public static void main(String[] args) throws Exception {

		// Launch Chrome browser
		WebDriver driver = new ChromeDriver();

		// Maximize browser window
		driver.manage().window().maximize();

		// Open the website
		driver.get("https://demoqa.com/automation-practice-form");

		// Explicit Wait
		WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10));

		// Enter First Name
		driver.findElement(By.id("firstName")).sendKeys("Aftab");

		// Enter Last Name
		driver.findElement(By.id("lastName")).sendKeys("Alam");

		// Enter User Email
		driver.findElement(By.id("userEmail")).sendKeys("aftab.alam@leadangel.com");

		// Select Male radio button
		driver.findElement(By.cssSelector("label[for='gender-radio-1']")).click();

		// Enter Mobile Number
		driver.findElement(By.id("userNumber")).sendKeys("8874285667");

		// Click on Date of Birth field
		driver.findElement(By.id("dateOfBirthInput")).click();

		// Select Month - November
		Select month = new Select(driver.findElement(By.className("react-datepicker__month-select")));

		month.selectByVisibleText("November");

		// Select Year - 1998
		Select year = new Select(driver.findElement(By.className("react-datepicker__year-select")));

		year.selectByVisibleText("1998");

		// Select Date - 15
		driver.findElement(By.xpath("//div[contains(@class,'react-datepicker__day') " + "and not(contains(@class,"
				+ "'react-datepicker__day--outside-month')) " + "and text()='15']")).click();

		driver.findElement(By.id("subjectsInput")).sendKeys("English");
		driver.findElement(By.id("subjectsInput")).sendKeys(Keys.ENTER);
		Thread.sleep(3000);

		// Select Sports
		driver.findElement(By.cssSelector("label[for='hobbies-checkbox-1']")).click();

		// Select Reading
		driver.findElement(By.cssSelector("label[for='hobbies-checkbox-2']")).click();

		// Select Music
		driver.findElement(By.cssSelector("label[for='hobbies-checkbox-3']")).click();

		// Upload Picture
		driver.findElement(By.id("uploadPicture"))
				.sendKeys("C:\\Users\\alama\\OneDrive\\Pictures\\Nature\\naturePic.png");

		// Enter Current Address
		driver.findElement(By.id("currentAddress")).sendKeys("Tarkulwa, Deoria, Uttar Pradesh, India - 274408");

		// Select State - Uttar Pradesh
		WebElement state = wait.until(ExpectedConditions.elementToBeClickable(By.id("react-select-3-input")));

		state.sendKeys("Uttar Pradesh");
		state.sendKeys(Keys.ENTER);

		// Select City
		WebElement city = wait.until(ExpectedConditions.elementToBeClickable(By.id("react-select-4-input")));

		city.sendKeys("Agra");
		city.sendKeys(Keys.ENTER);

		// Wait until Submit button is clickable
		wait.until(ExpectedConditions.elementToBeClickable(By.id("submit")));

		// Click Submit button
		driver.findElement(By.id("submit")).click();

		// Close browser
//        driver.quit();
	}
}
